# mock streams a canned answer offline; openai talks to any OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com

# Database (compose sets these for the app container)
DB_URL=jdbc:postgresql://localhost:5432/policydesk
DB_USER=policydesk
DB_PASSWORD=policydesk-local
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_STREAMS=200
UPSTREAM_TOTAL_TIMEOUT_SECONDS=90
# Set true only when running behind a reverse proxy you control
TRUST_PROXY=false

# Grounding
POLICY_DIR=../policies
RETRIEVAL_TOP_K=4
# BM25 score floor x100 (150 = 1.5) and share of question terms the best passage must contain
RETRIEVAL_MIN_SCORE_X100=150
RETRIEVAL_MIN_COVERAGE_PCT=50
RETRIEVAL_CANDIDATE_POOL=20
# Cross-encoder reranker (local ONNX). Score is a logit x100; passages below it are not used.
RERANKER_ENABLED=true
RERANKER_MIN_SCORE_X100=0
RERANKER_MODEL_SHA256=
MODEL_CACHE_DIR=
# Only behind an identity-aware proxy that sets X-User-Audience (customer|staff) and strips client values
TRUST_IDENTITY_HEADER=false
TIME_ZONE=Asia/Dubai
