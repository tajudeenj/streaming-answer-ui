# mock streams a canned answer offline; openai talks to any OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
# Azure OpenAI: set LLM_AUTH_HEADER=api-key and LLM_ENDPOINT to the deployment's chat/completions URL
LLM_AUTH_HEADER=Authorization
LLM_MODEL=gpt-4o-mini
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_STREAMS=200
UPSTREAM_TOTAL_TIMEOUT_SECONDS=90
# Set true only when running behind a reverse proxy you control
TRUST_PROXY=false
